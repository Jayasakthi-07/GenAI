// Stockroom — data model.
// Prisma 7: the connection URL lives in prisma.config.ts; the client uses @prisma/adapter-pg.
// Tables and columns are snake_case in PostgreSQL so raw analytics SQL stays readable.
// Constraints Prisma can't express (CHECKs, partial unique indexes, trigram search) are in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Shared enums ───────────────────────────

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  SIMULATOR
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ContentSource {
  AI
  RULE
}

// ─────────────────────────── People & settings ───────────────────────────

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  gstin     String?
  address   String?
  currency  String   @default("INR") @db.Char(3)
  locale    String   @default("en-IN")
  timezone  String   @default("Asia/Kolkata")
  /// briefingTime, serviceLevel, orderCost, holdingRate, dedupe windows, thresholds
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("organizations")
}

model User {
  id                 String             @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased.
  email              String             @unique
  name               String
  passwordHash       String             @map("password_hash")
  role               Role               @default(STAFF)
  isActive           Boolean            @default(true) @map("is_active")
  mustChangePassword Boolean            @default(false) @map("must_change_password")
  /// theme, density, sidebar state, notification prefs, onboarding state
  preferences        Json               @default("{}")
  lastLoginAt        DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  notifications      Notification[]
  savedViews         SavedView[]
  conversations      ChatConversation[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// sha256 of the cookie token; the raw token is never stored.
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?  @map("user_agent")
  ip         String?
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// JSON settings documents: "ai.routing", "simulation", "onboarding", …
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

/// Human-readable document numbers (PO-2026-00412). Incremented under a row lock inside the creating transaction.
model DocumentSequence {
  /// PO | GRN | SO | TRF | CC
  key  String
  year Int
  next Int    @default(1)

  @@id([key, year])
  @@map("document_sequences")
}

model SavedView {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "products", "movements", …
  page      String
  name      String
  /// filters, sort, visible columns, density
  state     Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, page, name])
  @@map("saved_views")
}

// ─────────────────────────── Catalog ───────────────────────────

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum AbcClass {
  A
  B
  C
}

enum XyzClass {
  X
  Y
  Z
}

model Unit {
  id       String    @id @default(uuid(7)) @db.Uuid
  code     String    @unique
  name     String
  products Product[]

  @@map("units")
}

model Category {
  id          String     @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  parentId    String?    @map("parent_id") @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0) @map("sort_order")
  products    Product[]
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                  String        @id @default(uuid(7)) @db.Uuid
  sku                 String        @unique
  barcode             String?       @unique
  name                String
  description         String?
  categoryId          String        @map("category_id") @db.Uuid
  category            Category      @relation(fields: [categoryId], references: [id])
  brand               String?
  unitId              String        @map("unit_id") @db.Uuid
  unit                Unit          @relation(fields: [unitId], references: [id])
  costPrice           Decimal       @map("cost_price") @db.Decimal(14, 2)
  sellingPrice        Decimal       @map("selling_price") @db.Decimal(14, 2)
  mrp                 Decimal?      @db.Decimal(14, 2)
  /// GST %
  taxRate             Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  imagePath           String?       @map("image_path")
  tags                String[]      @default([])
  status              ProductStatus @default(ACTIVE)
  trackExpiry         Boolean       @default(false) @map("track_expiry")
  shelfLifeDays       Int?          @map("shelf_life_days")
  reorderPoint        Int?          @map("reorder_point")
  safetyStock         Int?          @map("safety_stock")
  maxStock            Int?          @map("max_stock")
  leadTimeDays        Int?          @map("lead_time_days")
  abcClass            AbcClass?     @map("abc_class")
  xyzClass            XyzClass?     @map("xyz_class")
  classifiedAt        DateTime?     @map("classified_at") @db.Timestamptz(3)
  preferredSupplierId String?       @map("preferred_supplier_id") @db.Uuid
  preferredSupplier   Supplier?     @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  stockLevels   StockLevel[]
  batches       Batch[]
  movements     StockMovement[]
  supplierLinks SupplierProduct[]
  poLines       PurchaseOrderLine[]
  soLines       SalesOrderLine[]
  forecasts     Forecast[]
  alerts        Alert[]
  salesDaily    SalesDaily[]
  transferLines TransferLine[]
  countLines    CycleCountLine[]

  @@index([categoryId])
  @@index([status])
  @@index([abcClass, xyzClass])
  @@index([preferredSupplierId])
  @@map("products")
}

// ─────────────────────────── Stock ───────────────────────────

enum MovementType {
  OPENING_BALANCE
  RECEIPT
  SALE
  RETURN
  /// Goods leaving stock for internal use, samples or promotions (reason required).
  ISSUE
  ADJUSTMENT
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_CORRECTION
}

enum ReasonDirection {
  IN
  OUT
  BOTH
}

model Warehouse {
  id          String          @id @default(uuid(7)) @db.Uuid
  code        String          @unique
  name        String
  city        String
  address     String?
  isActive    Boolean         @default(true) @map("is_active")
  isDefault   Boolean         @default(false) @map("is_default")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  stockLevels StockLevel[]
  batches     Batch[]
  movements   StockMovement[]

  @@map("warehouses")
}

model StockLevel {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId    String    @map("warehouse_id") @db.Uuid
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  onHand         Int       @default(0) @map("on_hand")
  /// Confirmed-but-unfulfilled sales orders; available = onHand - reserved.
  reserved       Int       @default(0)
  /// Moving average, updated on receipts.
  avgCost        Decimal   @default(0) @map("avg_cost") @db.Decimal(14, 4)
  /// Per-warehouse replenishment policy (demand differs by location). Null → product defaults.
  reorderPoint   Int?      @map("reorder_point")
  safetyStock    Int?      @map("safety_stock")
  maxStock       Int?      @map("max_stock")
  lastMovementAt DateTime? @map("last_movement_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_levels")
}

model ReasonCode {
  id        String          @id @default(uuid(7)) @db.Uuid
  code      String          @unique
  label     String
  direction ReasonDirection
  appliesTo MovementType[]  @map("applies_to")
  isActive  Boolean         @default(true) @map("is_active")
  sortOrder Int             @default(0) @map("sort_order")
  movements StockMovement[]

  @@map("reason_codes")
}

/// The stock ledger. Append-only; written only by InventoryService.recordMovement().
model StockMovement {
  id           String       @id @default(uuid(7)) @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId  String       @map("warehouse_id") @db.Uuid
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batchId      String?      @map("batch_id") @db.Uuid
  batch        Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type         MovementType
  /// Signed: positive in, negative out.
  quantity     Int
  balanceAfter Int          @map("balance_after")
  unitCost     Decimal      @map("unit_cost") @db.Decimal(14, 4)
  reasonCodeId String?      @map("reason_code_id") @db.Uuid
  reasonCode   ReasonCode?  @relation(fields: [reasonCodeId], references: [id])
  /// Human reference, e.g. "PO-2026-00412".
  reference    String?
  /// PurchaseOrder | GoodsReceipt | SalesOrder | Transfer | CycleCount | Manual
  sourceType   String?      @map("source_type")
  sourceId     String?      @map("source_id") @db.Uuid
  note         String?
  actorType    ActorType    @map("actor_type")
  actorUserId  String?      @map("actor_user_id") @db.Uuid
  agentRunId   String?      @map("agent_run_id") @db.Uuid
  occurredAt   DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId, warehouseId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([type, occurredAt])
  @@index([sourceType, sourceId])
  @@index([occurredAt])
  @@map("stock_movements")
}

model Batch {
  id             String          @id @default(uuid(7)) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId    String          @map("warehouse_id") @db.Uuid
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batchNo        String          @map("batch_no")
  manufacturedOn DateTime?       @map("manufactured_on") @db.Date
  expiryDate     DateTime?       @map("expiry_date") @db.Date
  /// Remaining quantity; for trackExpiry products Σ batches = StockLevel.onHand.
  quantity       Int
  unitCost       Decimal         @map("unit_cost") @db.Decimal(14, 4)
  receivedAt     DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  movements      StockMovement[]

  @@unique([productId, warehouseId, batchNo])
  @@index([productId, warehouseId, expiryDate])
  @@index([expiryDate])
  @@map("batches")
}

/// Daily rollup maintained inside recordMovement() for SALE and RETURN movements.
model SalesDaily {
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String   @map("warehouse_id") @db.Uuid
  date        DateTime @db.Date
  quantity    Int
  revenue     Decimal  @db.Decimal(14, 2)
  cogs        Decimal  @db.Decimal(14, 2)
  orders      Int

  @@id([productId, warehouseId, date])
  @@index([date])
  @@map("sales_daily")
}

/// Nightly job + seed backfill; powers the value trend and turnover.
model InventorySnapshot {
  date            DateTime @db.Date
  warehouseId     String   @map("warehouse_id") @db.Uuid
  totalUnits      Int      @map("total_units")
  totalValue      Decimal  @map("total_value") @db.Decimal(16, 2)
  skuCount        Int      @map("sku_count")
  lowStockCount   Int      @map("low_stock_count")
  outOfStockCount Int      @map("out_of_stock_count")

  @@id([date, warehouseId])
  @@map("inventory_snapshots")
}

// ─────────────────────────── Purchasing ───────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model Supplier {
  id               String            @id @default(uuid(7)) @db.Uuid
  code             String            @unique
  name             String
  contactName      String?           @map("contact_name")
  email            String?
  phone            String?
  city             String?
  address          String?
  gstin            String?
  paymentTermsDays Int               @default(30) @map("payment_terms_days")
  isActive         Boolean           @default(true) @map("is_active")
  notes            String?
  /// 0–100, from the Supplier Analyst.
  score            Decimal?          @db.Decimal(5, 2)
  /// onTime, fillRate, leadTimeCv, priceTrend, quality + raw metrics
  scoreBreakdown   Json?             @map("score_breakdown")
  riskLevel        RiskLevel?        @map("risk_level")
  scoredAt         DateTime?         @map("scored_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  catalog          SupplierProduct[]
  purchaseOrders   PurchaseOrder[]
  preferredFor     Product[]         @relation("PreferredSupplier")
  alerts           Alert[]

  @@map("suppliers")
}

model SupplierProduct {
  id           String   @id @default(uuid(7)) @db.Uuid
  supplierId   String   @map("supplier_id") @db.Uuid
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku  String?  @map("supplier_sku")
  unitCost     Decimal  @map("unit_cost") @db.Decimal(14, 2)
  moq          Int      @default(1)
  packSize     Int      @default(1) @map("pack_size")
  leadTimeDays Int      @map("lead_time_days")
  isActive     Boolean  @default(true) @map("is_active")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([supplierId, productId])
  @@index([productId])
  @@map("supplier_products")
}

model PurchaseOrder {
  id            String              @id @default(uuid(7)) @db.Uuid
  /// PO-2026-00412
  number        String              @unique
  supplierId    String              @map("supplier_id") @db.Uuid
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId   String              @map("warehouse_id") @db.Uuid
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now()) @map("order_date") @db.Timestamptz(3)
  expectedDate  DateTime?           @map("expected_date") @db.Date
  subtotal      Decimal             @db.Decimal(14, 2)
  taxTotal      Decimal             @map("tax_total") @db.Decimal(14, 2)
  total         Decimal             @db.Decimal(14, 2)
  notes         String?
  /// Agent-drafted POs: overall rationale (shown with the AI marker).
  rationale     String?
  createdByType ActorType           @map("created_by_type")
  createdById   String?             @map("created_by_id") @db.Uuid
  agentRunId    String?             @map("agent_run_id") @db.Uuid
  agentActionId String?             @unique @map("agent_action_id") @db.Uuid
  submittedAt   DateTime?           @map("submitted_at") @db.Timestamptz(3)
  approvedById  String?             @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?           @map("approved_at") @db.Timestamptz(3)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(3)
  receivedAt    DateTime?           @map("received_at") @db.Timestamptz(3)
  closedAt      DateTime?           @map("closed_at") @db.Timestamptz(3)
  cancelledAt   DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?             @map("cancel_reason")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines         PurchaseOrderLine[]
  receipts      GoodsReceipt[]

  @@index([status])
  @@index([supplierId, orderDate])
  @@index([warehouseId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String             @id @default(uuid(7)) @db.Uuid
  purchaseOrderId  String             @map("purchase_order_id") @db.Uuid
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String             @map("product_id") @db.Uuid
  product          Product            @relation(fields: [productId], references: [id])
  quantityOrdered  Int                @map("quantity_ordered")
  quantityReceived Int                @default(0) @map("quantity_received")
  quantityRejected Int                @default(0) @map("quantity_rejected")
  unitCost         Decimal            @map("unit_cost") @db.Decimal(14, 2)
  taxRate          Decimal            @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal        Decimal            @map("line_total") @db.Decimal(14, 2)
  /// Per-line agent rationale.
  rationale        String?
  receiptLines     GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String             @id @default(uuid(7)) @db.Uuid
  /// GRN-2026-00188
  number          String             @unique
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String             @map("warehouse_id") @db.Uuid
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  actorType       ActorType          @map("actor_type")
  receivedById    String?            @map("received_by_id") @db.Uuid
  notes           String?
  lines           GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String            @id @default(uuid(7)) @db.Uuid
  goodsReceiptId      String            @map("goods_receipt_id") @db.Uuid
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String            @map("purchase_order_line_id") @db.Uuid
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  productId           String            @map("product_id") @db.Uuid
  quantityReceived    Int               @map("quantity_received")
  quantityRejected    Int               @default(0) @map("quantity_rejected")
  rejectReason        String?           @map("reject_reason")
  /// Invoiced cost; mismatches with the PO feed the Anomaly Auditor.
  unitCost            Decimal           @map("unit_cost") @db.Decimal(14, 2)
  batchNo             String?           @map("batch_no")
  expiryDate          DateTime?         @map("expiry_date") @db.Date

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

// ─────────────────────────── Sales ───────────────────────────

enum CustomerType {
  RETAIL
  WHOLESALE
  ONLINE
}

enum SalesChannel {
  STORE
  WHOLESALE
  ONLINE
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model Customer {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique
  name      String
  type      CustomerType
  email     String?
  phone     String?
  city      String?
  gstin     String?
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders    SalesOrder[]

  @@map("customers")
}

model SalesOrder {
  id            String           @id @default(uuid(7)) @db.Uuid
  /// SO-2026-08812
  number        String           @unique
  customerId    String?          @map("customer_id") @db.Uuid
  customer      Customer?        @relation(fields: [customerId], references: [id])
  warehouseId   String           @map("warehouse_id") @db.Uuid
  channel       SalesChannel
  status        SalesOrderStatus @default(DRAFT)
  orderDate     DateTime         @default(now()) @map("order_date") @db.Timestamptz(3)
  fulfilledAt   DateTime?        @map("fulfilled_at") @db.Timestamptz(3)
  subtotal      Decimal          @db.Decimal(14, 2)
  discountTotal Decimal          @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal      Decimal          @map("tax_total") @db.Decimal(14, 2)
  total         Decimal          @db.Decimal(14, 2)
  notes         String?
  createdByType ActorType        @map("created_by_type")
  createdById   String?          @map("created_by_id") @db.Uuid
  isSimulated   Boolean          @default(false) @map("is_simulated")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines         SalesOrderLine[]

  @@index([status])
  @@index([orderDate])
  @@index([customerId, orderDate])
  @@index([warehouseId, orderDate])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                String     @id @default(uuid(7)) @db.Uuid
  salesOrderId      String     @map("sales_order_id") @db.Uuid
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId         String     @map("product_id") @db.Uuid
  product           Product    @relation(fields: [productId], references: [id])
  quantity          Int
  quantityFulfilled Int        @default(0) @map("quantity_fulfilled")
  unitPrice         Decimal    @map("unit_price") @db.Decimal(14, 2)
  discount          Decimal    @default(0) @db.Decimal(14, 2)
  taxRate           Decimal    @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal         Decimal    @map("line_total") @db.Decimal(14, 2)

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_lines")
}

// ─────────────────────────── Operations ───────────────────────────

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum CycleCountStatus {
  OPEN
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum CountLineStatus {
  PENDING
  COUNTED
  ACCEPTED
  RECOUNT
}

model Transfer {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// TRF-2026-00031
  number          String         @unique
  fromWarehouseId String         @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String         @map("to_warehouse_id") @db.Uuid
  status          TransferStatus @default(DRAFT)
  reason          String?
  createdByType   ActorType      @map("created_by_type")
  createdById     String?        @map("created_by_id") @db.Uuid
  agentActionId   String?        @unique @map("agent_action_id") @db.Uuid
  shippedAt       DateTime?      @map("shipped_at") @db.Timestamptz(3)
  receivedAt      DateTime?      @map("received_at") @db.Timestamptz(3)
  cancelledAt     DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines           TransferLine[]

  @@index([status])
  @@map("transfers")
}

model TransferLine {
  id         String   @id @default(uuid(7)) @db.Uuid
  transferId String   @map("transfer_id") @db.Uuid
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  batchId    String?  @map("batch_id") @db.Uuid

  @@index([transferId])
  @@map("transfer_lines")
}

model CycleCount {
  id            String           @id @default(uuid(7)) @db.Uuid
  /// CC-2026-00017
  number        String           @unique
  warehouseId   String           @map("warehouse_id") @db.Uuid
  status        CycleCountStatus @default(OPEN)
  reason        String?
  dueDate       DateTime?        @map("due_date") @db.Date
  createdByType ActorType        @map("created_by_type")
  createdById   String?          @map("created_by_id") @db.Uuid
  agentActionId String?          @unique @map("agent_action_id") @db.Uuid
  submittedAt   DateTime?        @map("submitted_at") @db.Timestamptz(3)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(3)
  approvedById  String?          @map("approved_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  lines         CycleCountLine[]

  @@index([status])
  @@map("cycle_counts")
}

model CycleCountLine {
  id            String          @id @default(uuid(7)) @db.Uuid
  cycleCountId  String          @map("cycle_count_id") @db.Uuid
  cycleCount    CycleCount      @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  productId     String          @map("product_id") @db.Uuid
  product       Product         @relation(fields: [productId], references: [id])
  /// Snapshot when counting starts.
  expectedQty   Int             @map("expected_qty")
  countedQty    Int?            @map("counted_qty")
  variance      Int?
  varianceValue Decimal?        @map("variance_value") @db.Decimal(14, 2)
  status        CountLineStatus @default(PENDING)
  note          String?
  countedById   String?         @map("counted_by_id") @db.Uuid
  countedAt     DateTime?       @map("counted_at") @db.Timestamptz(3)

  @@unique([cycleCountId, productId])
  @@map("cycle_count_lines")
}

// ─────────────────────────── Intelligence ───────────────────────────

enum ForecastMethod {
  HOLT_WINTERS
  CROSTON_SBA
  SES
  MOVING_AVERAGE
}

enum DemandPattern {
  SMOOTH
  ERRATIC
  INTERMITTENT
  LUMPY
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  OVERSTOCK
  PROJECTED_STOCKOUT
  EXPIRING_BATCH
  DEMAND_SPIKE
  ANOMALY
  SUPPLIER_RISK
  FORECAST_SHIFT
  DEAD_STOCK
  SYSTEM
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  SNOOZED
  RESOLVED
}

model Forecast {
  id             String         @id @default(uuid(7)) @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// null = all warehouses
  warehouseId    String?        @map("warehouse_id") @db.Uuid
  method         ForecastMethod
  demandPattern  DemandPattern  @map("demand_pattern")
  horizonDays    Int            @map("horizon_days")
  historyDays    Int            @map("history_days")
  /// alpha, beta, gamma, phi, season length, …
  params         Json
  /// [{ date, yhat, lo80, hi80, lo95, hi95 }]
  points         Json
  avgDailyDemand Decimal        @map("avg_daily_demand") @db.Decimal(12, 4)
  demandStdDev   Decimal        @map("demand_std_dev") @db.Decimal(12, 4)
  /// Holdout backtest.
  mape           Decimal?       @db.Decimal(7, 2)
  /// Robust for intermittent demand.
  wape           Decimal?       @db.Decimal(7, 2)
  isLatest       Boolean        @default(true) @map("is_latest")
  agentRunId     String?        @map("agent_run_id") @db.Uuid
  generatedAt    DateTime       @default(now()) @map("generated_at") @db.Timestamptz(3)

  @@index([productId, isLatest])
  @@index([generatedAt])
  @@map("forecasts")
}

model Alert {
  id                String        @id @default(uuid(7)) @db.Uuid
  type              AlertType
  severity          Severity
  status            AlertStatus   @default(OPEN)
  /// 0–100 deterministic score; the AI may re-rank within bounds.
  priority          Int
  title             String
  /// Deterministic facts ("12 units left, 3.1 days of cover, lead time 7 days").
  message           String
  /// AI (or rule template) explanation.
  explanation       String?
  explanationSource ContentSource @map("explanation_source")
  modelUsed         String?       @map("model_used")
  productId         String?       @map("product_id") @db.Uuid
  product           Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId       String?       @map("warehouse_id") @db.Uuid
  supplierId        String?       @map("supplier_id") @db.Uuid
  supplier          Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  batchId           String?       @map("batch_id") @db.Uuid
  /// Metrics used ("data used" in the UI).
  data              Json
  dedupeKey         String        @map("dedupe_key")
  agentRunId        String?       @map("agent_run_id") @db.Uuid
  snoozedUntil      DateTime?     @map("snoozed_until") @db.Timestamptz(3)
  acknowledgedById  String?       @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt    DateTime?     @map("acknowledged_at") @db.Timestamptz(3)
  resolvedById      String?       @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolution        String?
  autoResolved      Boolean       @default(false) @map("auto_resolved")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, severity, createdAt])
  @@index([productId])
  @@index([type, status])
  @@index([dedupeKey])
  @@map("alerts")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// alert | approval | run_failed | po_received | report_ready
  type      String
  title     String
  body      String?
  link      String?
  severity  Severity?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ─────────────────────────── Agents ───────────────────────────

enum Autonomy {
  OBSERVE
  RECOMMEND
  ACT
}

enum RunTrigger {
  SCHEDULE
  EVENT
  MANUAL
  CHAT
  HANDOFF
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  NO_CHANGE
  FAILED
  CANCELLED
}

enum RunMode {
  AI
  RULE_BASED
}

enum StepType {
  CONTEXT
  ANALYSIS
  LLM_CALL
  TOOL_CALL
  THINKING
  VALIDATION_ERROR
  HANDOFF
  FINAL
  ERROR
}

enum ActionType {
  CREATE_PURCHASE_ORDER
  CREATE_TRANSFER
  UPDATE_REORDER_PARAMS
  CREATE_CYCLE_COUNT
  MARKDOWN_PRICE
  CHANGE_PREFERRED_SUPPLIER
}

enum ActionStatus {
  PENDING
  APPROVED
  EXECUTED
  REJECTED
  FAILED
  EXPIRED
}

model AgentDefinition {
  id            String        @id @default(uuid(7)) @db.Uuid
  /// stock_sentinel, demand_forecaster, …
  key           String        @unique
  name          String
  description   String
  systemPrompt  String        @map("system_prompt")
  allowedTools  String[]      @map("allowed_tools")
  /// { cron: ["*/15 * * * *"], events: ["stock.changed"], debounceMs, manual, chat }
  triggers      Json
  autonomy      Autonomy      @default(RECOMMEND)
  /// { providerKey, modelId }
  modelOverride Json?         @map("model_override")
  /// { maxSteps, maxToolCalls, timeoutMs, maxActionsPerRun, maxPoValue }
  limits        Json
  /// Agent-specific tunables (service level, budget, thresholds).
  config        Json
  isEnabled     Boolean       @default(true) @map("is_enabled")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  runs          AgentRun[]
  actions       AgentAction[]

  @@map("agent_definitions")
}

model AgentRun {
  id               String          @id @default(uuid(7)) @db.Uuid
  agentId          String          @map("agent_id") @db.Uuid
  agent            AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  trigger          RunTrigger
  /// Event name + payload summary, hand-off source, user id.
  triggerDetail    Json?           @map("trigger_detail")
  status           RunStatus       @default(QUEUED)
  mode             RunMode?
  /// What actually served the run.
  providerKey      String?         @map("provider_key")
  modelId          String?         @map("model_id")
  parentRunId      String?         @map("parent_run_id") @db.Uuid
  /// Hash of the deterministic findings, for "no change" detection.
  fingerprint      String?
  startedAt        DateTime?       @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?       @map("finished_at") @db.Timestamptz(3)
  durationMs       Int?            @map("duration_ms")
  promptTokens     Int?            @map("prompt_tokens")
  completionTokens Int?            @map("completion_tokens")
  stepCount        Int             @default(0) @map("step_count")
  toolCallCount    Int             @default(0) @map("tool_call_count")
  summary          String?
  /// Validated final output { summary, findings[], actions[] }.
  output           Json?
  error            Json?
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  steps            AgentStep[]
  actions          AgentAction[]

  @@index([agentId, createdAt(sort: Desc)])
  @@index([status])
  @@index([parentRunId])
  @@map("agent_runs")
}

model AgentStep {
  id         String   @id @default(uuid(7)) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq        Int
  type       StepType
  /// "Checking stock levels…", "Comparing 3 suppliers…"
  label      String
  toolName   String?  @map("tool_name")
  input      Json?
  output     Json?
  content    String?
  /// Separated <think>/reasoning content, shown collapsed.
  reasoning  String?
  error      Json?
  llmCallId  String?  @map("llm_call_id") @db.Uuid
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  durationMs Int?     @map("duration_ms")

  @@unique([runId, seq])
  @@map("agent_steps")
}

/// Proposals created by agent write tools.
model AgentAction {
  id              String          @id @default(uuid(7)) @db.Uuid
  /// Null when created from an Assistant confirmation outside a run.
  runId           String?         @map("run_id") @db.Uuid
  run             AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  agentId         String          @map("agent_id") @db.Uuid
  agent           AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type            ActionType
  status          ActionStatus    @default(PENDING)
  title           String
  summary         String
  rationale       String
  rationaleSource ContentSource   @map("rationale_source")
  modelUsed       String?         @map("model_used")
  /// Zod-validated per ActionType.
  payload         Json
  /// Edit-and-approve.
  editedPayload   Json?           @map("edited_payload")
  /// { cost, daysOfCoverGained, valueRecovered, riskReduced }
  expectedImpact  Json            @map("expected_impact")
  /// Citations: which tools and results backed the proposal.
  dataUsed        Json            @map("data_used")
  riskLevel       RiskLevel       @map("risk_level")
  dedupeKey       String          @map("dedupe_key")
  autoExecuted    Boolean         @default(false) @map("auto_executed")
  decidedById     String?         @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(3)
  decisionReason  String?         @map("decision_reason")
  executedAt      DateTime?       @map("executed_at") @db.Timestamptz(3)
  /// e.g. { purchaseOrderId, number }
  result          Json?
  error           Json?
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([agentId, createdAt])
  @@index([dedupeKey])
  @@map("agent_actions")
}

// ─────────────────────────── AI gateway ───────────────────────────

enum ProviderKind {
  OLLAMA
  OPENAI_COMPATIBLE
  GEMINI
  MOCK
}

enum ProviderHealth {
  CONNECTED
  INVALID_KEY
  RATE_LIMITED
  OFFLINE
  UNKNOWN
}

enum LlmCallStatus {
  SUCCESS
  ERROR
  RATE_LIMITED
  TIMEOUT
  INVALID_KEY
  BUDGET_EXCEEDED
  CANCELLED
}

enum LlmPurpose {
  AGENT
  CHAT
  PROBE
  CONNECTION_TEST
  LATENCY_TEST
}

model ProviderConfig {
  id                     String         @id @default(uuid(7)) @db.Uuid
  /// ollama, gemini, openrouter, groq, nvidia, cerebras, mistral, github, huggingface, lmstudio, custom-*
  key                    String         @unique
  kind                   ProviderKind
  displayName            String         @map("display_name")
  baseUrl                String         @map("base_url")
  /// AES-256-GCM (iv | tag | ciphertext) with APP_ENCRYPTION_KEY.
  apiKeyCiphertext       Bytes?         @map("api_key_ciphertext")
  apiKeyLast4            String?        @map("api_key_last4")
  extraHeadersCiphertext Bytes?         @map("extra_headers_ciphertext")
  isEnabled              Boolean        @default(false) @map("is_enabled")
  isCustom               Boolean        @default(false) @map("is_custom")
  /// rpm, concurrency, dailyBudget, timeoutMs, numCtx, keepAlive, disableThinking
  settings               Json
  health                 ProviderHealth @default(UNKNOWN)
  healthMessage          String?        @map("health_message")
  healthCheckedAt        DateTime?      @map("health_checked_at") @db.Timestamptz(3)
  latencyMs              Int?           @map("latency_ms")
  sortOrder              Int            @default(0) @map("sort_order")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("provider_configs")
}

/// Capabilities reported by the provider, or learned by a one-click probe.
model ModelCapability {
  providerKey   String   @map("provider_key")
  modelId       String   @map("model_id")
  /// { tools, vision, thinking, embedding, structuredOutput }
  capabilities  Json
  contextWindow Int?     @map("context_window")
  /// REPORTED | PROBED
  source        String
  probedAt      DateTime @default(now()) @map("probed_at") @db.Timestamptz(3)

  @@id([providerKey, modelId])
  @@map("model_capabilities")
}

model LlmCall {
  id               String        @id @default(uuid(7)) @db.Uuid
  providerKey      String        @map("provider_key")
  modelId          String        @map("model_id")
  purpose          LlmPurpose
  agentKey         String?       @map("agent_key")
  runId            String?       @map("run_id") @db.Uuid
  status           LlmCallStatus
  errorCode        String?       @map("error_code")
  /// Sanitized; never contains keys.
  errorMessage     String?       @map("error_message")
  promptTokens     Int?          @map("prompt_tokens")
  completionTokens Int?          @map("completion_tokens")
  latencyMs        Int           @map("latency_ms")
  attempt          Int           @default(1)
  isFallback       Boolean       @default(false) @map("is_fallback")
  startedAt        DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)

  @@index([startedAt])
  @@index([providerKey, startedAt])
  @@index([runId])
  @@map("llm_calls")
}

model ChatConversation {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid(7)) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role           String
  content        String
  /// Tables, charts, confirmation cards, citations.
  parts          Json?
  /// Assistant turns are AgentRuns (trigger CHAT), so they get a full trace.
  runId          String?          @map("run_id") @db.Uuid
  modelUsed      String?          @map("model_used")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum ReportType {
  DAILY_BRIEFING
  WEEKLY_SUMMARY
}

model Report {
  id              String        @id @default(uuid(7)) @db.Uuid
  type            ReportType
  title           String
  periodStart     DateTime      @map("period_start") @db.Timestamptz(3)
  periodEnd       DateTime      @map("period_end") @db.Timestamptz(3)
  /// { kpis, changes, risks, agentActivity, pendingDecisions, narrative }
  content         Json
  narrativeSource ContentSource @map("narrative_source")
  modelUsed       String?       @map("model_used")
  runId           String?       @map("run_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([type, createdAt])
  @@map("reports")
}

model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  agentKey    String?   @map("agent_key")
  agentRunId  String?   @map("agent_run_id") @db.Uuid
  /// "product.update", "po.approve", "stock.adjust", "ai.provider.update", …
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  summary     String?
  /// Secrets are redacted before writing.
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([agentRunId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
