{
  "name": "@stockroom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#generated/*": "./src/generated/*"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/main.ts",
    "build": "tsdown",
    "start": "cross-env NODE_ENV=production node dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:setup": "prisma migrate deploy && prisma generate && tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "check:ledger": "tsx src/scripts/check-ledger.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@stockroom/shared": "workspace:*",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.0.2"
  }
}
