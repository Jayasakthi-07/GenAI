# ─────────────────────────────────────────────────────────────────────────────
# Stockroom environment. Copy to .env with `pnpm bootstrap` (it also generates the secrets).
# Everything runs on this machine; servers bind to 127.0.0.1 only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
# API host and port. Keep HOST on 127.0.0.1 so nothing is reachable from the network.
# (API_PORT rather than PORT: some tools inject a generic PORT into every child process.)
HOST=127.0.0.1
API_PORT=4000
# Vite dev server port (the dev UI proxies /api to the server, so cookies stay same-origin).
WEB_PORT=5173
# Extra browser origins allowed to call the API (comma-separated). The defaults cover
# http://127.0.0.1 and http://localhost on API_PORT and WEB_PORT.
APP_ORIGINS=
# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Database (PostgreSQL 16+) ───────────────────────────────────────────────
# Replace CHANGE_ME with the password of the `stockroom` role (URL-encode special characters).
DATABASE_URL=postgresql://stockroom:CHANGE_ME@127.0.0.1:5432/stockroom
# Used only by integration tests. It is created automatically if the role has CREATEDB.
TEST_DATABASE_URL=postgresql://stockroom:CHANGE_ME@127.0.0.1:5432/stockroom_test

# ── Security (generated by `pnpm bootstrap`; never commit real values) ──────
# Signs the session cookie. At least 32 characters.
COOKIE_SECRET=
# 32 random bytes, base64. Encrypts AI provider API keys stored in the database (AES-256-GCM).
# Changing it makes stored keys unreadable; you would have to re-enter them.
APP_ENCRYPTION_KEY=
# Session lifetime in hours.
SESSION_TTL_HOURS=168

# ── Demo data ───────────────────────────────────────────────────────────────
# Fixed random seed so the demo dataset is identical on every reset.
SEED=20260927
# Show the demo accounts and their password on the sign-in screen (handy for presentations).
DEMO_MODE=true
# Organization timezone used for daily rollups, schedules and the briefing time.
APP_TIMEZONE=Asia/Kolkata

# ── AI providers (all optional) ─────────────────────────────────────────────
# Keys entered in Settings → AI & models are stored encrypted and take precedence.
# These are only a fallback. With none of them set and Ollama running, everything works offline.
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
HUGGINGFACE_API_KEY=
